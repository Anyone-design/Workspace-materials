{
  "deep-agentic-pipeline-hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./skills/deep-agentic-pipeline/scripts/git-safety-hook.js",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./skills/deep-agentic-pipeline/scripts/post-tool-hook.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
